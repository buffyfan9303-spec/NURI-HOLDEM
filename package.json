{
  "name": "---",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-sitemap.mjs && node scripts/gen-thumbs.mjs && tsc -b && node scripts/gen-legal.mjs && vite build",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "thumbs": "node scripts/gen-thumbs.mjs",
    "legal": "node scripts/gen-legal.mjs",
    "legal:check": "node scripts/gen-legal.mjs --check",
    "licenses": "node scripts/gen-licenses.mjs",
    "licenses:check": "node scripts/gen-licenses.mjs --check",
    "playstore:assets": "node scripts/playstore-shots.mjs --fixture && node scripts/playstore-feature.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "analyze": "node scripts/analyze.mjs",
    "bundle:budget:update": "node scripts/bundle-budget.mjs --update",
    "lint": "node scripts/lint.mjs",
    "knip": "knip",
    "migrations:squawk": "node scripts/squawk-check.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "secrets": "secretlint \"**/*\" --format compact",
    "preview": "vite preview",
    "test:e2e": "npm run test:e2e:main && npm run test:e2e:boot",
    "test:e2e:main": "playwright test --grep-invert @boot",
    "test:e2e:boot": "playwright test --grep @boot --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:mutation": "node scripts/mutation-check.mjs",
    "test:watch": "vitest",
    "gate": "node scripts/gate.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@portone/browser-sdk": "^0.1.11",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/speed-insights": "^2.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.48.0",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-kakao-maps-sdk": "^1.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@projectwallace/css-analyzer": "^9.9.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "schema-dts": "^2.0.0",
    "secretlint": "^13.0.6",
    "sharp": "^0.35.3",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "hyperid": {
      "uuid": "^11.1.1"
    }
  }
}
