{
  "name": "---",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-sitemap.mjs && node scripts/gen-thumbs.mjs && tsc -b && node scripts/gen-legal.mjs && vite build",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "thumbs": "node scripts/gen-thumbs.mjs",
    "legal": "node scripts/gen-legal.mjs",
    "legal:check": "node scripts/gen-legal.mjs --check",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "bundle:budget:update": "node scripts/bundle-budget.mjs --update",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks || true",
    "secrets": "secretlint \"**/*\" --format compact",
    "preview": "vite preview",
    "test:e2e": "npm run test:e2e:main && npm run test:e2e:boot",
    "test:e2e:main": "playwright test --grep-invert @boot",
    "test:e2e:boot": "playwright test --grep @boot --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:mutation": "node scripts/mutation-check.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@portone/browser-sdk": "^0.1.9",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.34.0",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-kakao-maps-sdk": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.11.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.26",
    "secretlint": "^13.0.5",
    "sharp": "^0.35.3",
    "supabase": "^2.115.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
